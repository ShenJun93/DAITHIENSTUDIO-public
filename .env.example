# ---------------------------------------------------------------------------
# Đại Thiên Tài AI Visual Studio — environment example
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# Database (SQLite for local MVP; swap for postgresql://... to use Postgres)
DATABASE_URL="./data/studio.db"

# Storage
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="./storage"
PUBLIC_BASE_URL="http://localhost:3000"
N8N_DELIVERY_ALLOWED_HOSTS=""

# Default provider selection. "mock" runs fully offline, costs nothing.
# Options: mock | google | comfyui (image only, experimental)
AI_TEXT_PROVIDER="mock"
AI_IMAGE_PROVIDER="mock"
AI_VIDEO_PROVIDER="mock"
AI_VOICE_PROVIDER="mock"

# ComfyUI local experiment. Export an API-format workflow is not required for
# this first slice; the adapter uses only core nodes and one installed
# checkpoint. Loopback HTTP endpoints only. Leave both empty to disable it.
COMFYUI_BASE_URL="http://127.0.0.1:8188"
COMFYUI_IMAGE_MODEL="v1-5-pruned-emaonly.safetensors"
COMFYUI_POLL_INTERVAL_MS="1000"

# Google AI (only needed when a provider above is set to "google")
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=""
GOOGLE_TEXT_MODEL="gemini-2.0-flash"
GOOGLE_IMAGE_MODEL="imagen-3.0-generate-002"
GOOGLE_VIDEO_MODEL="veo-2.0-generate-001"
GOOGLE_TTS_VOICE="vi-VN-Standard-A"

# Generation guard rails
MAX_CONCURRENT_JOBS="2"
JOB_TIMEOUT_MS="600000"
COST_LIMIT_USD_PER_PROJECT="25"

# Single-operator local auth. Set a value to require the X-Studio-Key header
# (or ?key= on GET) for API mutations. Leave empty for open local dev.
STUDIO_API_KEY=""
